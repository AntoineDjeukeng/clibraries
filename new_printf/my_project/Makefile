# Compiler and flags
CC := gcc
CFLAGS := -Wall -Wextra -Werror -pedantic -Iinclude -MMD -MP
LDFLAGS :=

# Project name
TARGET := my_project

# Find all .c files under src/
SRC := $(shell find src -name "*.c") $(wildcard tests/*.c)

OBJ := $(SRC:.c=.o)
DEPS := $(OBJ:.o=.d)

# Default target
all: $(TARGET)

# Link the final executable
$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $@ $(LDFLAGS)

# Compile .c to .o, generating dependency files
%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

# Include dependency files (auto-regenerated by -MMD)
-include $(DEPS)

# Valgrind test run
valgrind: $(TARGET)
	valgrind --leak-check=full --track-origins=yes ./$(TARGET)

# Clean object, executable, and dependency files
clean:
	rm -f $(OBJ) $(TARGET) $(DEPS)

.PHONY: all clean valgrind
